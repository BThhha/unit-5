// ========== MODE DEFINITIONS ==========
int mode;
final int INTRO = 0;
final int SETTINGS = 1;
final int GAME = 2;
final int PAUSE = 3;
final int GAMEOVER = 4;

// ========== GAME VARIABLES ==========


